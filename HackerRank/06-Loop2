import java.util.*;

class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int q = sc.nextInt();

        for (int i = 0; i < q; i++) {
            int a = sc.nextInt();
            int b = sc.nextInt();
            int n = sc.nextInt();

            int sum = a;
            int term = b;

            for (int j = 0; j < n; j++) {
                sum = sum + term;
                
                if (j > 0) {
                    System.out.print(" ");
                }
                System.out.print(sum);

                term = term * 2;
            }

            System.out.println();
        }
    }
}
